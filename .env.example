# Claude API kaliti: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Telegram bot tokeni: Telegram'da @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Bot nomi (@ belgisisiz), saytda bot havolasini koʻrsatish uchun
TELEGRAM_BOT_USERNAME=

# Ixtiyoriy sozlamalar
# Saytning https manzili: berilsa bot webhook rejimida ishlaydi (Render buni o'zi beradi)
PUBLIC_URL=
# Bitta foydalanuvchi bir soatda nechta savol bera oladi (xarajatni cheklash uchun)
REQUESTS_PER_HOUR=20
# Model va fikrlash darajasi (low | medium | high)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
